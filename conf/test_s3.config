/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the minimal test dataset staged to S3
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same content as conf/test.config, but every input/reference points at
    s3://dlay-nextflow-dev/rnaseq-test instead of GitHub raw URLs, so the run
    works in network-restricted environments (e.g. AWS HealthOmics).

    Use as follows:
        nextflow run nf-core/rnaseq -profile test_s3,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile (S3)'
    config_profile_description = 'Minimal test dataset staged to s3://dlay-nextflow-dev'

    // Base location for the staged test data
    s3_test_base       = 's3://dlay-nextflow-dev/rnaseq-test'

    // Input data
    input              = "${params.s3_test_base}/samplesheet/samplesheet.csv"

    // Genome references
    fasta              = "${params.s3_test_base}/reference/genome.fasta"
    gtf                = "${params.s3_test_base}/reference/genes_with_empty_tid.gtf.gz"
    gff                = "${params.s3_test_base}/reference/genes.gff.gz"
    transcript_fasta   = "${params.s3_test_base}/reference/transcriptome.fasta"
    additional_fasta   = "${params.s3_test_base}/reference/gfp.fa.gz"

    bbsplit_fasta_list = "${params.s3_test_base}/reference/bbsplit_fasta_list.txt"
    hisat2_index       = "${params.s3_test_base}/reference/hisat2.tar.gz"
    salmon_index       = "${params.s3_test_base}/reference/salmon.tar.gz"
    kraken_db          = "${params.s3_test_base}/kraken/kraken2.tar.gz"

    // Other parameters
    skip_bbsplit        = false
    pseudo_aligner      = 'salmon'
    umitools_bc_pattern = 'NNNN'
}

process {
    // When using RSEM, remove warning from STAR whilst building tiny indices
    withName: 'RSEM_PREPAREREFERENCE_GENOME|SENTIEON_RSEMPREPAREREFERENCE_GENOME' {
        ext.args2 = "--genomeSAindexNbases 7"
    }

    // Add seeds for reproducibility in rRNA removal tools
    withName: '.*:BOWTIE2_ALIGN$' {
        ext.args = '--very-sensitive-local --seed 1 --reorder'
    }
    withName: '.*:BOWTIE2_ALIGN_PE$' {
        ext.args = '--very-sensitive-local --seed 1 --reorder'
    }
    withName: '.*:RIBODETECTOR' {
        ext.args = '--seed 1'
    }
}
