// conf/omics.config — applied only when running on AWS HealthOmics.
// Wired in at the end of nextflow.config, guarded on the AWS_WORKFLOW_RUN env var
// that HealthOmics sets inside every task, so the pipeline stays portable.

params {
    // nf-core writes final results under params.outdir; HealthOmics copies this
    // directory to the StartRun outputUri. It MUST resolve to the publish dir.
    outdir = '/mnt/workflow/pubdir'
}

process {
    // HealthOmics maps CPU/memory to omics instance families and provides its
    // own executor — do NOT set an executor here. Keep light retries for the
    // transient failures that show up on first-run container mirroring.
    withName: '.*' {
        errorStrategy = 'retry'
        maxRetries    = 1
    }
}

// The nf-core execution reports (timeline/report/trace/dag) are written directly
// by the Nextflow head process to params.outdir — they do NOT go through
// publishDir, so HealthOmics (which only exports publishDir outputs) never copies
// them to S3. Redirect them straight to an S3 prefix the run role can write to.
// The head engine has S3 access even in RESTRICTED networking mode.
timeline {
    enabled   = true
    overwrite = true
    file      = "s3://dlay-nextflow-dev/reports/${params.trace_report_suffix}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "s3://dlay-nextflow-dev/reports/${params.trace_report_suffix}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "s3://dlay-nextflow-dev/reports/${params.trace_report_suffix}/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "s3://dlay-nextflow-dev/reports/${params.trace_report_suffix}/pipeline_dag.html"
}
